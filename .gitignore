.env
.env.*
!.env.example
*.pem
*.key
credentials.json
aws_credentials

# ─── MODEL WEIGHTS AND DATA — see CLD_S6 rule 5, 5 GB submission limit ──────
*.tflite
*.task
*.blob
*.caffemodel
*.onnx
*.pt
*.pth
*.h5
data/raw/
data/interim/

# ─── RECORDED MEDIA — see RSK_S8.3, consent required before committing ──────
*.mp4
*.mov
*.avi
*.mkv

# ─── EDITOR AND OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ─── REFERENCE CLONES — see RIX_S5.2 and CLD_S6 rules 6 and 7 ───────────────
# Exclude everything under ref_repo/, then re-admit only the report documents.
# Reports sit at ref_repo/<track>/<slug>/<CODE>_<name>.md — three levels deep,
# because the clones were regrouped into tracking/ and translation/.
ref_repo/**
!ref_repo/
!ref_repo/*/
!ref_repo/*/*/
!ref_repo/*/*/[A-Z][A-Z][A-Z]_*.md
ref_repo/*/*/*/
