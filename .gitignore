*.py[cod]
*.egg-info/
/.venv*/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp/

# ─── LOCAL WORKING NOTES ────────────────────────────────────────────────────
/plan/backend-todo.md
/front_back_contract/

